{
  "name": "trustvault",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*",
    "services/*"
  ],
  "scripts": {
    "build": "npm run build -w @trustvault/contracts && npm run build -w @trustvault/api && npm run build -w @trustvault/mock-gateway && npm run build -w trustvault-web",
    "dev:web": "npm run dev -w trustvault-web",
    "dev:api": "npm run start:dev -w @trustvault/api",
    "dev:gateway": "npm run dev -w @trustvault/mock-gateway",
    "db:generate": "npm run prisma:generate -w @trustvault/api",
    "db:push": "npm run prisma:push -w @trustvault/api",
    "test": "npm run test -w @trustvault/contracts && npm run test -w @trustvault/api && npm run test -w @trustvault/mock-gateway"
  },
  "devDependencies": {
    "@inquirer/core": "^10.3.2",
    "@vitest/expect": "3.2.7",
    "@vitest/mocker": "3.2.7",
    "@vitest/pretty-format": "3.2.7",
    "@vitest/runner": "3.2.7",
    "@vitest/snapshot": "3.2.7",
    "@vitest/spy": "3.2.7",
    "@vitest/utils": "3.2.7"
  },
  "engines": {
    "node": ">=20.9"
  }
}
